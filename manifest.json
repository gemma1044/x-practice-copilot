{
  "manifest_version": 3,
  "name": "X Practice Copilot",
  "version": "0.1.1",
  "description": "在 X 帖子旁生成诚实评论、沉淀灵感并准备视频复刻提示词。",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://x.com/*", "https://twitter.com/*", "http://127.0.0.1:4317/*"],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content/content-script.js"],
      "css": ["src/content/content-script.css"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "src/sidepanel/index.html"
  },
  "action": {
    "default_title": "打开 X Practice Copilot"
  }
}
